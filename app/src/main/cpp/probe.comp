#version 450
#if TEST >= 15
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_shader_subgroup_basic : require
#elif TEST == 1
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#elif TEST == 9
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#elif TEST == 10
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#elif TEST == 11
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_ballot : require
#elif TEST == 2
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#elif TEST == 3
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#elif TEST == 8
#extension GL_EXT_shader_atomic_float : require
#elif TEST == 4
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#pragma use_vulkan_memory_model
#endif
layout(local_size_x=64) in;
#if TEST == 8
layout(set=0,binding=0,std430) buffer B { float v[]; } b;
#else
layout(set=0,binding=0,std430) buffer B { uint v[]; } b;
#endif
#if TEST == 5
shared uint scratch[64];
#endif
#if TEST >= 42 && TEST < 69 && (((TEST-42)%9)==1 || ((TEST-42)%9)==5)
layout(push_constant) uniform Coefficients { uint b; uint c; } coefficients;
#endif
void main() {
 uint i=gl_LocalInvocationID.x;
#if TEST >= 165
 #define BKIND (((TEST-165)%6)/2)
 #define BDEPEND ((TEST-165)%2==0)
 #if BKIND == 0
  #define BT float16_t
  #define BSEED(k) float16_t(unpackHalf2x16(b.v[320+64*(k)+i]).x)
  #define BM float16_t(unpackHalf2x16(b.v[192+i]).x)
  #define BC float16_t(unpackHalf2x16(b.v[256+i]).x)
  #define BOUT(v) floatBitsToUint(float(v))
 #elif BKIND == 1
  #define BT float
  #define BSEED(k) float(float16_t(unpackHalf2x16(b.v[320+64*(k)+i]).x))
  #define BM float(float16_t(unpackHalf2x16(b.v[192+i]).x))
  #define BC float(float16_t(unpackHalf2x16(b.v[256+i]).x))
  #define BOUT(v) floatBitsToUint(v)
 #else
  #define BT f16vec2
  #define BSEED(k) f16vec2(unpackHalf2x16(b.v[320+64*(k)+i]))
  #define BM f16vec2(unpackHalf2x16(b.v[192+i]))
  #define BC f16vec2(unpackHalf2x16(b.v[256+i]))
  #define BOUT(v) packHalf2x16(vec2(v))
 #endif
 BT a0=BSEED(0),a1=BSEED(1),a2=BSEED(2),a3=BSEED(3);
 BT m=BM,c=BC;
 for(uint j=0u;j<256u;j++){
 #if BDEPEND
  // One recurrence through four FMA instructions; retain all four outputs.
  a1=fma(a0,m,c);a2=fma(a1,m,c);a3=fma(a2,m,c);a0=fma(a3,m,c);
 #else
  a0=fma(a0,m,c);a1=fma(a1,m,c);a2=fma(a2,m,c);a3=fma(a3,m,c);
 #endif
 }
 uint dest=640u+4u*(gl_WorkGroupID.x*64u+i);
 b.v[dest]=BOUT(a0);b.v[dest+1]=BOUT(a1);b.v[dest+2]=BOUT(a2);b.v[dest+3]=BOUT(a3);
#elif TEST >= 129
 #define EPOS (((TEST-129)%12)/4)
 #define EOP ((TEST-129)%4)
 #if EPOS == 0
  float a=uintBitsToFloat(b.v[128+i]);
 #else
  float a=unpackHalf2x16(b.v[320+i]).x;
 #endif
 #if EPOS == 1
  float y=uintBitsToFloat(b.v[192+i]);
 #else
  float y=unpackHalf2x16(b.v[384+i]).x;
 #endif
 #if EPOS == 2
  float z=uintBitsToFloat(b.v[256+i]);
 #else
  float z=unpackHalf2x16(b.v[448+i]).x;
 #endif
 float16_t ah=float16_t(a),bh=float16_t(y),ch=float16_t(z);
 #if EOP == 0
  b.v[i]=floatBitsToUint(float(fma(ah,bh,ch)));
 #elif EOP == 1
  b.v[i]=floatBitsToUint(fma(float(ah),float(bh),float(ch)));
 #elif EOP == 2
  vec2 other=unpackHalf2x16(b.v[576+i]);
  b.v[i]=packHalf2x16(vec2(float(fma(ah,bh,ch)),other.y));
 #else
  vec2 other=unpackHalf2x16(b.v[576+i]);
  b.v[i]=packHalf2x16(vec2(other.x,float(fma(ah,bh,ch))));
 #endif
 b.v[64+i]=gl_SubgroupSize;
#elif TEST >= 69
 #define HPR_KIND ((TEST-69)%12)
 #define HPR_POSITION (HPR_KIND/4)
 #define HPR_OP (HPR_KIND%4)
 #if HPR_POSITION == 0
 float a=uintBitsToFloat(b.v[128+i]);
 #else
 float a=unpackHalf2x16(b.v[320+i]).x;
 #endif
 #if HPR_POSITION == 1
 float y=uintBitsToFloat(b.v[192+i]);
 #else
 float y=unpackHalf2x16(b.v[384+i]).x;
 #endif
 #if HPR_POSITION == 2
 float z=uintBitsToFloat(b.v[256+i]);
 #else
 float z=unpackHalf2x16(b.v[448+i]).x;
 #endif
 float16_t ah=float16_t(a),bh=float16_t(y),ch=float16_t(z);
 float result;
 #if HPR_OP == 0
 result=float(fma(ah,bh,ch));
 #elif HPR_OP == 1
 result=float(ah*bh+ch);
 #elif HPR_OP == 2
 result=fma(float(ah),float(bh),float(ch));
 #else
 precise float16_t product=ah*bh;
 precise float16_t answer=product+ch;
 result=float(answer);
 #endif
 b.v[i]=floatBitsToUint(result);b.v[64+i]=gl_SubgroupSize;
#elif TEST >= 42
 #define HPO_KIND ((TEST-42)%9)
 float source=uintBitsToFloat(b.v[128+i]);
 float16_t x=float16_t(source);
 #if HPO_KIND == 1 || HPO_KIND == 5
 vec2 by=unpackHalf2x16(coefficients.b),cz=unpackHalf2x16(coefficients.c);
 #else
 vec2 by=unpackHalf2x16(b.v[256+i]),cz=unpackHalf2x16(b.v[320+i]);
 #endif
 #if HPO_KIND == 8
 float16_t y=float16_t(by.y),z=float16_t(cz.y);
 #else
 float16_t y=float16_t(by.x),z=float16_t(cz.x);
 #endif
 #if HPO_KIND == 2
 x=-x;
 #elif HPO_KIND == 3
 x=abs(x);z=-z;
 #endif
 float result;
 #if HPO_KIND == 6
 result=fma(float(x),float(y),float(z));
 #elif HPO_KIND == 7
 precise float16_t product=x*y;
 precise float16_t answer=product+z;
 result=float(answer);
 #elif HPO_KIND == 4 || HPO_KIND == 5
 result=float(x*y+z);
 #else
 result=float(fma(x,y,z));
 #endif
 b.v[i]=floatBitsToUint(result);b.v[64+i]=gl_SubgroupSize;
#elif TEST >= 24
 #define HP_KIND ((TEST-24)%6)
 float source;
 #if HP_KIND == 0
 source=float(b.v[192+i]);
 #else
 source=uintBitsToFloat(b.v[128+i]);
 #endif
 float16_t answer;
 #if HP_KIND == 3
 answer=float16_t(fma(source,1.5,0.5));
 #elif HP_KIND == 4
 precise float16_t x=float16_t(source);
 precise float16_t product=x*float16_t(1.5);
 precise float16_t sum=product+float16_t(0.5);
 answer=sum;
 #elif HP_KIND == 5
 float16_t x=float16_t(source);
 float16_t y=float16_t(unpackHalf2x16(b.v[256+i]).x);
 float16_t z=float16_t(unpackHalf2x16(b.v[320+i]).x);
 answer=fma(x,y,z);
 #elif HP_KIND == 2
 float16_t x=float16_t(source);
 answer=fma(x,float16_t(1.5),float16_t(0.5));
 #else
 float16_t x=float16_t(source);
 answer=x*float16_t(1.5)+float16_t(0.5);
 #endif
 b.v[i]=floatBitsToUint(float(answer));
 b.v[64+i]=gl_SubgroupSize;
#elif TEST >= 15
 f16vec2 x=f16vec2(unpackHalf2x16(b.v[128+i]));
 f16vec2 y=f16vec2(unpackHalf2x16(b.v[192+i]));
 f16vec2 z=f16vec2(unpackHalf2x16(b.v[256+i]));
 f16vec2 answer;
 #if ((TEST-15)%3) == 0
 answer.x=fma(x.x,y.x,z.x);
 answer.y=fma(x.y,y.y,z.y);
 #elif ((TEST-15)%3) == 1
 answer=fma(x,y,z);
 #else
 precise f16vec2 product=x*y;
 precise f16vec2 sum=product+z;
 answer=sum;
 #endif
 b.v[i]=packHalf2x16(vec2(answer));
 b.v[64+i]=gl_SubgroupSize;
#elif TEST == 1
 b.v[i]=(gl_SubgroupSize<<16)|subgroupAdd(1u);
#elif TEST == 2
 float16_t x=float16_t(float(b.v[64+i]));
 float16_t y=x*float16_t(1.5)+float16_t(0.5);
 b.v[i]=floatBitsToUint(float(y));
#elif TEST == 3
 int8_t x=int8_t(b.v[64+i]);
 int8_t y=x*int8_t(3)+int8_t(1);
 b.v[i]=uint(int(y));
#elif TEST == 4
 coopmat<float16_t,gl_ScopeSubgroup,16,16,gl_MatrixUseA> a=coopmat<float16_t,gl_ScopeSubgroup,16,16,gl_MatrixUseA>(float16_t(float(b.v[64])));
 coopmat<float16_t,gl_ScopeSubgroup,16,16,gl_MatrixUseB> x=coopmat<float16_t,gl_ScopeSubgroup,16,16,gl_MatrixUseB>(float16_t(float(b.v[65])));
 coopmat<float,gl_ScopeSubgroup,16,16,gl_MatrixUseAccumulator> z=coopmat<float,gl_ScopeSubgroup,16,16,gl_MatrixUseAccumulator>(0.0);
 z=coopMatMulAdd(a,x,z);
 uint bad=0u;
 for(int j=0;j<z.length();j++) if(z[j]!=32.0) bad++;
 b.v[i]=bad;
#elif TEST == 10
 float16_t a=float16_t(float(b.v[64+i]));
 f16vec2 x=f16vec2(a,a+float16_t(1.0));
 f16vec2 y=fma(x,f16vec2(float16_t(1.5)),f16vec2(float16_t(0.5)));
 b.v[i]=floatBitsToUint(float(y.x)+float(y.y));
#elif TEST == 11
 uint uniformValue=subgroupBroadcastFirst(b.v[64]);
 uint a=b.v[64+i];
 b.v[i]=(a*7u+uniformValue*3u)^i;
#elif TEST == 9
 uint cell=gl_SubgroupInvocationID%16u;
 uint row=cell/4u, col=cell%4u;
 float seed=float(b.v[64]);
 float av=float(row+col)+seed, bv=float(row+col)+seed;
 float sum=0.0;
 for(uint k=0u;k<4u;k++)sum+=subgroupShuffle(av,row*4u+k)*subgroupShuffle(bv,k*4u+col);
 b.v[i]=(cell<<16)|uint(sum);
#elif TEST == 8
 atomicAdd(b.v[i],1.5);
 atomicAdd(b.v[i],2.5);
#elif TEST == 5
 scratch[i]=b.v[64+i];
 barrier();
 b.v[i]=scratch[63-i];
#else
 b.v[i]=b.v[64+i]*7u+3u;
#endif
}
